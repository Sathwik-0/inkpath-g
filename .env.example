# ==============================================================================
# INKPATH AI - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

# Supabase (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase (SECRET - Server Only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Security & Crypto Enclave (SECRET - Server Only: 32 random bytes, base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=your-32-byte-base64-secret

# Background Job Runner Secret (SECRET - Server Only)
JOB_RUNNER_SECRET=your-random-job-runner-secret

# Platform Gemini Key for Free Chapters (SECRET - Server Only)
GEMINI_PLATFORM_KEY=your-gemini-api-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Global Safety Valve
PLATFORM_SAFETY_VALVE_ENABLED=false
